<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Геолокация -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Фоновый сервис трекинга -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Уведомления (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Отключение энергосбережения для стабильного фонового трекинга -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- ИЗМЕНЕНО: разрешения INTERNET/ACCESS_NETWORK_STATE убраны — вырезан
         единственный код, которому они были нужны (онлайн-фолбэк карты
         через OSM, см. MapController). Приложение строго офлайн: только
         Mapsforge-карта из SAF-папки или заглушка. Открытие списка файлов
         карт в системном браузере (SettingsActivity) не требует этих
         разрешений у НАШЕГО приложения — сеть там использует браузер. -->
    <application
        android:name=".TrailBackApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrailBack"
        tools:targetApi="34">
        <activity
            android:name=".ui.map.MapActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.compass.CompassActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.menu.MenuActivity"
            android:exported="false" />
        <activity
            android:name=".ui.menu.EntryPointsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.menu.MarkedPlacesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.menu.SettingsActivity"
            android:exported="false" />
        <service
            android:name=".service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>