<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">
    <include
        android:id="@+id/topInfoPanel"
        layout="@layout/view_top_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- НОВОЕ (по просьбе): текст "буква стороны + курс в градусах"
         (например "СЗ 311"), который раньше рисовался крупным текстом в
         центре диска компаса (см. CompassView — drawCenterHeadingText()
         убрана), теперь вынесен сюда, над самим диском. Обновляется в
         CompassActivity.updateHeadingLabel() на каждый тик курса. -->
    <TextView
        android:id="@+id/headingLabelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_white"
        android:textSize="32sp"
        android:textStyle="bold"
        tools:text="СЗ 311"
        app:layout_constraintTop_toBottomOf="@id/topInfoPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- ИЗМЕНЕНО (по просьбе — "придвинь ближе к диску, отступ на высоту
         шрифта градусов"): раньше отступ сверху был тем же 24dp, что и у
         остальных сторон (общий layout_margin), из-за чего между
         headingLabelText и диском оставался непропорционально большой
         пустой промежуток. marginTop теперь отдельно и заметно меньше —
         примерно равен высоте строки текста headingLabelText (32sp),
         остальные стороны (Start/End/Bottom) по-прежнему 24dp. -->
    <com.trailback.app.ui.compass.CompassView
        android:id="@+id/compassView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/headingLabelText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- Предупреждение о точности компаса: наложено поверх нижнего поля
         compassView (margin=24dp), НЕ участвует в его констрейнтах —
         размер и позиция самого компаса не меняются. Цвет #999999,
         шрифт 16sp — см. решение по ТЗ.
         Кликабельно — открывает пункт меню "Калибровка" (см. CompassActivity).
         ИСПРАВЛЕНО: ширина была wrap_content с констрейнтами на Start И End
         одновременно, но без layout_constrainedWidth="true" — в ConstraintLayout
         это означает, что wrap_content меряется БЕЗ учёта доступного места
         между констрейнтами (виджет может стать шире экрана), а не
         "ужимается" под него. Для длинного текста предупреждения это
         сужало реальную кликабельную зону до сути неполной центральной
         части строки — палец легко промахивался мимо. match_parent
         (с теми же marginStart/End=16dp) убирает эту ловушку: TextView
         переносится по словам как положено, а тач-область/ripple
         покрывают всю строку целиком. -->
    <TextView
        android:id="@+id/compassWarningText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="#999999"
        android:text="@string/compass_warning"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>