<?xml version="1.0" encoding="utf-8"?>
<!-- НОВОЕ: подпись разработчика внизу экрана меню — тот же "тихий" стиль
     мелкого серого текста, что уже используется для версии приложения на
     экране "О приложении" (см. SettingsActivity.versionText, 12sp
     text_gray) — чтобы не спорить по весу с самими пунктами меню. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menuList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/developerCreditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- ИЗМЕНЕНО: android:autoLink="email" убран — он открывал голый
         mailto: без темы письма. Тема нужна заранее ("Приложение,
         ТропаДомой, TrailBack" — по просьбе), а autoLink такого не умеет
         (не поддерживает query-параметры в mailto:), поэтому переход
         собирается вручную в MenuActivity.setupDeveloperCreditClick() —
         тот же паттерн (подчёркивание программно + selectableItemBackground
         + clickable), что уже используется для compassWarningText в
         CompassActivity. -->
    <TextView
        android:id="@+id/developerCreditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/developer_credit"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>